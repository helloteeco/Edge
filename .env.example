# Edge by Teeco — environment variables
# Copy this file to .env.local for local work. Leave the values empty here.
# In production, set the same names in Vercel > Project > Settings > Environment Variables.
# Do not put real keys in this file.

# Database (Supabase). SUPABASE_URL is preferred.
# NEXT_PUBLIC_SUPABASE_URL is still accepted if it is already set.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; it is not the service role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Preferred for server routes. Never use a NEXT_PUBLIC_ name for this.
SUPABASE_SERVICE_ROLE_KEY=

# Third-party data
MASHVISOR_API_KEY=
GEOAPIFY_API_KEY=
AIRBNB_API_KEY=
PRICELABS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_API_KEY=
HUD_API_TOKEN=

# Admin access. These must be set or the admin pages and tools stay locked.
ADMIN_PASSWORD=
ADMIN_API_KEY=
PRECACHE_ADMIN_SECRET=
CRON_SECRET=
ADMIN_EMAILS=

# Email
RESEND_API_KEY=
MAGIC_LINK_SECRET=

# AI assistant and blog drafts
OPENAI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_POWER=
